{
  "name": "dsh-purge",
  "version": "1.2.0-unrestricted",
  "description": "DeepSeek Harness 破甲（yin1895 二开自维护版 · v1.2.0 无限制版：区域/银行门禁、知识库下架、续跑夹断等限制全部移除；基线 HunYiSage/dsh-purge v1.1.92 + 上游 1.1.71 能力回填）。Jailbreak for every model — swap prompts per model. 二次开发：能力对齐与客户端适配见 DERIVATION.md；上游署名要求见 README。",
  "author": "dsh-purge maintainers; self-maintained fork by yin1895",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "README.ja.md",
    "DERIVATION.md"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "assert:unrestricted": "node scripts/self/assert-unrestricted.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "Apache-2.0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yin1895/dsh-purge.git"
  },
  "homepage": "https://github.com/yin1895/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/yin1895/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://codeload.github.com/yin1895/dsh-purge/tar.gz/refs/heads/master",
      "zip": "https://codeload.github.com/yin1895/dsh-purge/zip/refs/heads/master",
      "git": "https://github.com/yin1895/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.3",
  "dshTargets": [
    "0.2.1-rc.3",
    "0.2.1-rc.2",
    "0.2.1-rc.5"
  ]
}
